# Python bytecode & cache files
__pycache__/
*.py[cod]
*$py.class
.Python/

# Runtime data (exclude logs, pidfiles)
monitor.log		# Main server log in ~/ai/tmp/keymon/
*~			# Backup files (*.file~)

# Local AI security config (not part of source code)
opencode.json		# Bash permission wall at root

# Manuals (large PDFs, not part of source code)
pssa50_en_mr_a0.pdf
pssa50_en_om_e0.pdf

# PDF text extractions (temporary)
pssa50.txt
pssa50_om.txt

# Exclude IDE / editor artifacts (prevent accidental commits)
.vscode/
.idea/
*.swp
*.swo

# OS-specific cache on Mac/Linux
.DS_Store
Thumbs.db

# Logs in general — exclude runtime logs from any parent dir (*log)
*.log

# Playwright browser automation snapshots & screenshots (ephemeral test artifacts)
.playwright-mcp/
*.png
